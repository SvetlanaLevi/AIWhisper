{
  "Worker": {
    "RootDirectory": "DialogExtractor",
    "EventOrderingDelayMs": 250,
    "DialogueEndDelayMs": 500,
    "DirectoryPollIntervalMs": 2000,
    "FilePollIntervalMs": 500,
    "ServerLogFileName": "server.log",
    "ClientLogFileName": "client.log",
    "WorkerLogFileName": "worker.log",
    "CheckpointFileName": "worker-state.json",
    "AudioDirectoryName": "audio",
    "SystemPromptPath": "config/ai-system-prompt.txt",
    "MaxConversationHistoryEntries": 20,
    "LateEventCompletedRetentionMinutes": 30
  },
  "OpenAI": {
    "Model": "gpt-4.1-mini",
    "MaxRetries": 3,
    "RetryBaseDelayMs": 1000,
    "TimeoutSeconds": 60
  },
  "Tts": {
    "Provider": "EventLab",
    "BaseUrl": "http://localhost:5055",
    "Endpoint": "/v1/tts",
    "Voice": null,
    "Format": "wav",
    "ApiKeyEnvironmentVariable": "EVENTLAB_API_KEY",
    "TimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
